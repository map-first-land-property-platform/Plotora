POSTGRES_DB=plotora_db
POSTGRES_USER=plotora_app
POSTGRES_PASSWORD=replace-with-a-private-development-password

# Password recovery works locally with Mailpit without the optional settings below.
# Before deployment, configure a real SMTP provider; never commit actual credentials.
# WEB_BASE_URL=https://your-plotora-domain.example
# CORS_ORIGIN=https://your-plotora-domain.example
# MAIL_HOST=smtp.your-provider.example
# MAIL_PORT=587
# MAIL_USERNAME=your-private-smtp-username
# MAIL_PASSWORD=your-private-smtp-password
# MAIL_FROM=no-reply@your-verified-domain.example
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# COOKIE_SECURE=true
# JWT_SECRET=replace-with-at-least-32-random-private-bytes
# MAIL_QUEUE_SECRET=replace-with-a-different-32-byte-random-private-secret
# RECOVERY_PRODUCTION=true
